# Application Settings
PROJECT_NAME="Team Building Portal"
VERSION="1.0.0"
DEBUG=True

# Security
# Thay bằng chuỗi sinh ra từ lệnh `openssl rand -hex 32` nếu chạy thực tế
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Đảm bảo bạn đang có thư mục `data` nằm trong thư mục `backend/`
DATABASE_URL=sqlite:///./data/teambuilding.db

# CORS Origins
# Định dạng chuẩn JSON array (không dùng nháy đơn bọc ngoài)
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:80"]

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@company.com
SMTP_PASSWORD=your-email-password
SMTP_FROM_EMAIL=noreply@teambuilding.company.com
SMTP_FROM_NAME="Team Building Portal"

# Admin Default Credentials (for initial setup)
ADMIN_EMAIL=admin@company.com
ADMIN_PASSWORD=ChangeThisPassword123!