# API base URL
# Khi chạy local trực tiếp với FastAPI:
VITE_API_URL=http://localhost:8000/api/v1

# Khi chạy qua Nginx/Docker reverse proxy:
# VITE_API_URL=/api/v1

# Tên ứng dụng
VITE_APP_NAME=Team Building Portal

# Môi trường hiện tại
VITE_APP_ENV=development

# Bật/tắt React Query Devtools ở môi trường development
VITE_ENABLE_QUERY_DEVTOOLS=true

# Thời gian polling Gala Dinner, tính bằng milliseconds
VITE_GALA_POLLING_INTERVAL=3000

# Timeout gọi API, tính bằng milliseconds
VITE_API_TIMEOUT=30000
